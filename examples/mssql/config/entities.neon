# No type overrides needed anywhere below — is_active (BIT), balance (MONEY)
# and external_id (UNIQUEIDENTIFIER) are all auto-detected by SqlsrvGeneratorAdapter.

roles:
	class: Role
	comment: "Uživatelská role"

users:
	class: User
	comment: "Aplikační uživatel"
	searchable:
		- email
	references:
		role_id: { name: role, comment: "Role uživatele" }
	hasMany:
		orders:
			through: user_id

orders:
	class: Order
	comment: "Objednávka"
